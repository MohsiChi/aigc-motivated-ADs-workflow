# 复制为 .env 并填入真实值。.env 已被 .gitignore 排除，绝不提交。
# 真实 key 只放本地 .env，代码一律 os.getenv 读取。

# ---- LLM（真实模式必填；MOCK 模式可留空）----
DEEPSEEK_API_KEY=sk-your-key-here
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# LLM_MODEL=deepseek-chat

# ---- 运行模式 ----
# MOCK_LLM=1 时全流程零成本、离线可跑（默认）；=0 才真实调用上面的 LLM
MOCK_LLM=1

# ---- 素材生成 Provider：mock | pollinations | jimeng ----
# mock        = 纯本地占位（测试档，零成本离线）
# pollinations= 免费无 Key 真实图（境外服务，不稳定；失败时任务报错留痕，可手动切回 mock）
# jimeng      = 即梦等真实多模态后端（v2，需 Key；未实现时启动自动回退 mock）
GEN_PROVIDER=mock

# ---- 流水线参数 ----
# MAX_SCENE_RETRIES=2
# DEFAULT_SCENE_COUNT=3
